# GA4 측정 ID (예: G-XXXXXXXXXX). Vercel Production 환경 변수에만 설정. 로컬·프리뷰에서는 비워 두면 전송하지 않는다.
NEXT_PUBLIC_GA_ID=
# 배포 도메인. sitemap, canonical, OG URL에 사용. Vercel에서는 비워 두면 프로젝트 프로덕션 도메인(*.vercel.app)을 자동으로 쓰고, 커스텀 도메인을 연결하면 여기에 지정한다.
NEXT_PUBLIC_SITE_URL=https://example.com
# 검색엔진 소유 확인 코드(선택). Search Console / 네이버 서치어드바이저에서 HTML 태그 방식 선택 시 content 값만 넣는다.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
